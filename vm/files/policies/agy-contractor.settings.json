{
  "toolPermission": "proceed-in-sandbox",
  "enableTerminalSandbox": true,
  "disableSandboxBypass": true,
  "telemetryEnabled": false,
  "trustedWorkspaces": [
    "/data/projects/contractor"
  ],
  "permissions": {
    "allow": [
      "read_file(/data/projects/contractor)",
      "write_file(/data/projects/contractor)",
      "command(git status)",
      "command(git diff)",
      "command(git log)",
      "command(git add)",
      "command(python3)",
      "command(ls)",
      "command(cat)"
    ],
    "deny": [
      "read_file(/secure-admin)",
      "write_file(/secure-admin)",
      "read_file(/root)",
      "read_file(/etc/shadow)",
      "read_file(/etc/antigravity)",
      "write_file(/etc)",
      "read_file(/opt/corp-tools)",
      "write_file(/opt/corp-tools)",
      "read_file(/home/contractor/.ssh)",
      "write_file(/home/contractor/.ssh)",
      "write_file(/home/contractor/.gemini/antigravity-cli/settings.json)",
      "write_file(/home/contractor/.gemini/antigravity/browserAllowlist.txt)",
      "read_file(/data/projects/dev)",
      "read_file(/data/projects/shared)",
      "execute_url(*)",
      "mcp(*)",
      "command(ssh)",
      "command(scp)",
      "command(sftp)",
      "command(ping)",
      "command(ping6)",
      "command(nc)",
      "command(ncat)",
      "command(netcat)",
      "command(nmap)",
      "command(telnet)",
      "command(xfreerdp)",
      "command(xfreerdp3)",
      "command(rdesktop)",
      "command(sudo)",
      "command(su)",
      "command(jamf)",
      "command(nsdiag)",
      "command(vpncli)",
      "command(google-chrome)",
      "command(google-chrome-stable)",
      "command(curl)",
      "command(wget)",
      "command(git push)",
      "command(git clone)",
      "command(git remote)",
      "command(pip)",
      "command(pip3)",
      "command(npm)",
      "command(npx)",
      "command(rm)",
      "command(rmdir)",
      "command(shred)",
      "command(truncate)",
      "command(mv)",
      "command(find -delete)",
      "command(git clean)",
      "command(git reset --hard)",
      "command(dd)",
      "read_file(/home/contractor/.aws)",
      "read_file(/home/contractor/.config/gcloud)",
      "read_file(/home/contractor/.docker)",
      "read_file(/home/contractor/.kube)",
      "read_file(/home/contractor/.netrc)",
      "read_file(/home/contractor/.git-credentials)",
      "read_file(/home/contractor/.config/gh)",
      "read_file(/data/projects/contractor/.env)",
      "write_file(/home/contractor/.bashrc)",
      "write_file(/home/contractor/.profile)",
      "write_file(/home/contractor/.antigravity)",
      "read_url(pastebin.com)",
      "read_url(requestbin.com)",
      "read_url(webhook.site)",
      "read_url(ngrok.io)",
      "read_url(ngrok-free.app)",
      "read_url(transfer.sh)",
      "read_url(termbin.com)",
      "execute_url(pastebin.com)",
      "execute_url(webhook.site)",
      "read_url(169.254.169.254)",
      "execute_url(169.254.169.254)",
      "read_url(metadata.google.internal)",
      "execute_url(metadata.google.internal)",
      "read_url(gist.github.com)",
      "execute_url(gist.github.com)",
      "read_url(gist.githubusercontent.com)",
      "execute_url(gist.githubusercontent.com)",
      "read_url(*.pipedream.net)",
      "execute_url(*.pipedream.net)",
      "read_url(*.interact.sh)",
      "execute_url(*.interact.sh)",
      "read_url(*.oastify.com)",
      "execute_url(*.oastify.com)",
      "read_url(*.burpcollaborator.net)",
      "execute_url(*.burpcollaborator.net)",
      "read_url(*.trycloudflare.com)",
      "execute_url(*.trycloudflare.com)",
      "read_url(file.io)",
      "execute_url(file.io)",
      "read_url(*.requestbin.com)",
      "execute_url(*.requestbin.com)",
      "mcp(untrusted_external/*)",
      "write_file(/tmp)",
      "write_file(/var/tmp)",
      "write_file(/dev/shm)",
      "write_file(/home/contractor/.gemini/config)",
      "write_file(/home/contractor/.gemini/settings.json)",
      "write_file(/home/contractor/.gemini/GEMINI.md)",
      "write_file(/home/contractor/.gemini/antigravity-cli/bin)",
      "write_file(/home/contractor/.config)",
      "write_file(/home/contractor/.local/bin)"
    ],
    "ask": [
      "command(git commit)",
      "command(npm publish)",
      "command(docker build)",
      "command(kubectl apply)",
      "execute_url(localhost)"
    ]
  },
  "allowNonWorkspaceAccess": false,
  "artifactReviewPolicy": "asks-for-review",
  "showFeedbackSurvey": false
}
