      ".env.sample",
      ".env.template",
      ".env.dist",
      ".env.defaults",
      "*.env.example",
      "*.env.sample",
      "*.env.template"
    ],
    "deny_sandbox_bypass": true,
    "deny_write_dirnames": [
      ".agents",
      ".gemini",
      ".antigravity"
    ],
    "deny_write_files": [
