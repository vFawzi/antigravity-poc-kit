{
  "_comment": "Root-owned policy for /usr/local/libexec/agy-hook. Regexes (Python re) on the full command line (also matches env/command/bash -c wrappers and absolute paths). default applies to every group; groups add to it. ask_commands = user approval; workspace_only_commands = allowed only on paths inside the persona workspace. deny_write_files / exec_content_* / deny_config_commands / gcloud_deny_verbs: shared with windows/files/hooks/gen-policy.py (kept identical by a unit test); agent_service_account is set per group from metadata agy-agent-sa. audit_classes = rule classes whose denies are only logged (AUDIT_ALLOW) and allowed - destructive, workspace_write, workspace_commands only; a group list replaces the default list; critical classes are always enforced. mcp_allowed_servers = MCP servers the agent may call ([] = none; a group list replaces the default list). deny_write_secrets = credentials ({name, regex}) the agent may not write into files.",
  "default": {
    "deny_commands": [
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(ssh|scp|sftp|telnet|nc|ncat|netcat|socat|nmap|masscan|zmap|hping3)(\\s|$)",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(shred|srm|wipe|gpg)(\\s|$)",
      "openssl\\s+enc\\b",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(sendmail|swaks|mutt|mail)(\\s|$)",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(jamf|nsdiag|vpncli)(\\s|$)",
      "/opt/corp-tools/",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(sudo|su|doas|pkexec|chattr|chflags)(\\s|$)",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?curl\\b[^;|&]*\\s(-d|--data\\S*|-F|--form\\S*|-T|--upload-file|--json)(\\s|=|$)",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?wget\\b[^;|&]*\\s--(post-data|post-file|body-data|body-file|method=(POST|PUT|PATCH))",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(ba|z|da|k)?sh\\s+(-\\S+\\s+)*-[a-zA-Z]*i",
      "/dev/(tcp|udp)/",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(xdg-open|sensible-browser|x-www-browser|exo-open|google-chrome\\S*|chromium\\S*|firefox|gio\\s+open|kde-open\\S*|gnome-open)(\\s|$)",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(ngrok|cloudflared|devtunnel|localtunnel|lt|bore|frpc)(\\s|$)",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(code|code-insiders)\\s+tunnel\\b",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(tailscale)\\s+(?:funnel|serve)\\b",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(run0|machinectl|systemd-run|newgrp|sg|setcap|usermod|gpasswd|at|chsh|chfn|update-ca-certificates)(\\s|$)",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(loginctl)\\s+enable-linger\\b",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(sysctl)\\b[^;|&]*\\s-w\\b",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(certutil)\\b(?=[^;|&]*\\s-d\\s+['\\\"]?sql:)[^;|&]*\\s-[ADEMN]\\b",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(trust)\\s+anchor\\b",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(crontab)(?!\\s+-l(?:\\s|$))(?:\\s|$)",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(docker|podman|nerdctl)[^;|&]*(?:\\s(?:--privileged|--cap-add|--device)\\b|\\s--(?:pid|network|net|ipc|userns|uts)[= ]host\\b|\\s--security-opt[= ]\\S*unconfined|\\s(?:-v|--volume)[= ]?['\\\"]?/:|docker\\.sock|docker_engine|\\s--mount[= ]\\S*source=/[,\\s])",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(curl|wget)(?:\\s[^;&]*)?\\|\\s*(?:sudo(?:\\s+-\\S+)*\\s+|env(?:\\s+-\\S+)*(?:\\s+[A-Za-z_]\\w*=\\S*)*\\s+)?(?:\\S*/)?(sh|bash|zsh|dash|ksh|python(?:\\d+(?:\\.\\d+)?)?|perl|ruby|node|php)(?:\\s+-[A-Za-z]+)*(?:\\s+--?(?=\\s|$|['\\\"])|\\s*(?=$|[;&|)]|['\\\"]\\s*(?:$|[;&|)])))",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(sh|bash|zsh|dash|ksh|python(?:\\d+(?:\\.\\d+)?)?|perl|ruby|node|php|source|eval|\\.)\\s[^;&|]*?(?:<\\(|\\$\\(|`)\\s*(?:\\S*/)?(curl|wget)(\\s|$)",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?git\\b[^;&|]*?\\spush\\b[^;&|]*?(?:\\s--repo[= ]|\\s['\\\"]?(?:(?:https?|ssh|git|file|ftps?)://|[A-Za-z0-9._-]+@[A-Za-z0-9.-]+:|[/~]|\\.\\.?/))",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(?:(base64|base32|basenc)\\b[^;&|]*?\\s(?:-[A-Za-z]*[dD][A-Za-z]*(?=\\s|$|[|)'\"])|--decode\\b)|xxd\\b[^;&|]*?\\s-[A-Za-z]*r|openssl\\s+(?:base64|enc)\\b[^;&|]*?\\s-d\\b)[^;&]*\\|\\s*(?:sudo(?:\\s+-\\S+)*\\s+|env(?:\\s+-\\S+)*(?:\\s+[A-Za-z_]\\w*=\\S*)*\\s+)?(?:\\S*/)?(sh|bash|zsh|dash|ksh|python(?:\\d+(?:\\.\\d+)?)?|perl|ruby|node|php)(?:\\s+-[A-Za-z]+)*(?:\\s+--?(?=\\s|$|['\\\"])|\\s*(?=$|[;&|)]|['\\\"]\\s*(?:$|[;&|)])))",
      "(?:^|[;|&`('\\\"]|\\$\\()\\s*(?:(?:env|command|nohup|time|nice|exec|xargs|timeout\\s+\\S+)(?:\\s+-\\S+)*\\s+|[A-Za-z_]\\w*=\\S*\\s+)*(?:\\S*/)?(sh|bash|zsh|dash|ksh|python(?:\\d+(?:\\.\\d+)?)?|perl|ruby|node|php|source|eval|\\.)\\s[^;&|]*?(?:<\\(|\\$\\(|`)[^)`]*?(?:(base64|base32|basenc)\\b[^)`]*?\\s(?:-[A-Za-z]*[dD][A-Za-z]*(?=\\s|$|[|)'\"])|--decode\\b)|xxd\\b[^)`]*?\\s-[A-Za-z]*r|openssl\\s+(?:base64|enc)\\b[^)`]*?\\s-d\\b)"
    ],
    "deny_paths": [
      "/secure-admin",
      "/root",
      "/etc/shadow",
      "/etc/gshadow",
      "/etc/sudoers",
      "/etc/antigravity",
      "/Library/Application Support/Antigravity",
      "/etc/agy-credproxy",
      "/opt/corp-tools",
      "~/.ssh",
      "~/.gnupg",
      "~/.aws",
      "~/.config/gcloud",
      "~/.docker",
      "~/.kube",
      "~/.netrc",
      "~/.git-credentials",
      "~/.config/gh",
      "~/.local/share/keyrings",
      "~/Library/Keychains",
      "~/Library/Application Support/Google/Chrome",
      "~/Library/Application Support/Firefox",
      "~/Library/Application Support/Microsoft Edge",
      "~/Library/Safari",
      "~/Library/Cookies",
      "~/.mozilla",
      "~/.config/google-chrome",
      "~/.config/chromium",
      "~/.config/microsoft-edge",
      "~/.config/BraveSoftware"
    ],
    "deny_tools": [],
    "ask_commands": [],
    "workspace_only_commands": [
      "chmod",
      "chown",
      "chgrp"
    ],
    "workspace": "/data/projects/{user}",
    "write_tools": "(write|edit|replace|create|delete|remove|move|rename|patch|append|save)",
    "write_also": [
      "~/.gemini/antigravity-cli/brain"
    ],
    "deny_file_globs": [
      ".env",
      ".env.*",
      "*.env",
      "*.pem",
      "id_rsa",
      "id_ed25519",
      "*.p12",
      "*.pfx",
      "credentials.json"
    ],
    "allow_file_globs": [
