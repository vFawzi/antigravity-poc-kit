      "wheel",
      "admin",
      "docker",
      "libvirt",
      "lxd"
    ],
    "audit_classes": [],
    "mcp_allowed_servers": [],
    "deny_write_secrets": [
      {
        "name": "aws_access_key",
        "regex": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b[\\s\\S]{0,300}?(?<![A-Za-z0-9/+=])(?=[A-Za-z0-9/+=]*[a-z])(?=[A-Za-z0-9/+=]*[A-Z])[A-Za-z0-9/+=]{40}(?![A-Za-z0-9/+=])|(?<![A-Za-z0-9/+=])(?=[A-Za-z0-9/+=]*[a-z])(?=[A-Za-z0-9/+=]*[A-Z])[A-Za-z0-9/+=]{40}(?![A-Za-z0-9/+=])[\\s\\S]{0,300}?\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"
      },
      {
        "name": "gcp_service_account_key",
        "regex": "(?s)\\A(?=.*\\\"type\\\"\\s*:\\s*\\\"service_account\\\")(?=.*\\\"private_key\\\"\\s*:\\s*\\\"-----BEGIN)"
      },
      {
        "name": "private_key",
        "regex": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |ENCRYPTED |PGP )?PRIVATE KEY(?: BLOCK)?-----(?:\\s|\\\\[nr])+(?:[A-Za-z0-9+/=]{16,}|Proc-Type:|Version:|Comment:)"
      },
      {
        "name": "github_token",
        "regex": "\\b(?:ghp|gho|ghs|ghu|ghr)_[A-Za-z0-9]{36}\\b|\\bgithub_pat_[A-Za-z0-9_]{50,}"
      },
      {
        "name": "gitlab_token",
        "regex": "\\bglpat-[A-Za-z0-9_-]{20,}"
      },
      {
        "name": "slack_token",
        "regex": "\\bxox[baprs]-[A-Za-z0-9-]{10,}"
      },
      {
        "name": "google_api_key",
        "regex": "\\bAIza[0-9A-Za-z_-]{35}(?![0-9A-Za-z_-])"
      },
      {
        "name": "azure_storage_key",
        "regex": "(?i)AccountKey=[A-Za-z0-9+/]{60,}={0,2}"
      },
      {
        "name": "jwt",
        "regex": "\\beyJ(?=[A-Za-z0-9_.-]{97,})[A-Za-z0-9_-]{5,}\\.eyJ[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]{16,}"
      }
    ]
  },
  "groups": {
