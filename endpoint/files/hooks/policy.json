    "exec_content_patterns": [
      "(?i)<\\s*Exec\\b",
      "(?i)<\\s*UsingTask\\b",
      "(?i)\\bTaskFactory\\b",
      "\\\"(?:pre|post)?install\\\"\\s*:",
      "\\\"prepare\\\"\\s*:",
      "\\\"(?:pre|post)(?:pack|publish)\\\"\\s*:",
      "\\\"prepublish(?:Only)?\\\"\\s*:"
