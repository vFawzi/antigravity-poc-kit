    "deny_config_commands": [
      "(?i)\\b(?:npx|pnpx|bunx|dlx)(?:\\.cmd)?\\s+(?:-\\S+\\s+)*(?:localtunnel|lt|ngrok|cloudflared)(?:@\\S*)?(?:\\s|$)",
      "(?i)\\bgit(?:\\.exe)?\\s+(?:-\\S+\\s+)*config\\b(?![^;|&]*\\s(?:--get\\S*|--list|-l|--show-origin|--show-scope)(?:\\s|$))",
      "(?i)\\bgit(?:\\.exe)?\\s[^;|&]*-c\\s+['\\\"]?(?:core\\.(?:hookspath|fsmonitor|sshcommand|pager|editor|askpass)|credential\\.|url\\.|http\\.proxy|include\\.)",
      "(?i)\\bgit(?:\\.exe)?\\s+remote\\s+(?:add|set-url)\\b",
      "(?i)\\b(?:npm|pnpm|yarn)(?:\\.cmd)?\\s+config\\s+(?:set|delete|edit)\\b",
      "(?i)\\bnpm(?:\\.cmd)?\\s+set\\s",
      "(?i)\\bpip3?(?:\\.exe)?\\s+config\\s+(?:set|unset|edit)\\b",
      "(?i)\\bdotnet(?:\\.exe)?\\s+nuget\\s+(?:add|update|enable)\\s+source\\b",
      "(?i)\\bnuget(?:\\.exe)?\\s+sources?\\s+(?:add|update|enable)\\b",
      "(?i)\\s--(?:registry|index-url|extra-index-url|trusted-host)(?:[= ]|$)",
      "(?i)\\bdotnet(?:\\.exe)?\\s[^;|&]*\\s(?:-s|--source|--add-source)\\s"
