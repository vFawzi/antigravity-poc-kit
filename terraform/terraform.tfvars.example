# Normally GENERATED by ./install.sh from install.conf. Manual use: copy to terraform.tfvars (git-ignored).
project_id = "my-agy-project"
region     = "europe-west4"
zone       = "europe-west4-a"

operator_principals = ["user:admin@example.com"]
secops_email        = "secops@example.com"

apparmor_mode = "enforce"
enable_cmek   = true

# Device mTLS front door: enable_mtls deploys it, require_mtls cuts traffic over (false = rollback)
enable_mtls  = true
require_mtls = true

# Persona desktop: xrdp over IAP (passwords in Secret Manager), clipboard allowed
desktop_access = "xrdp"
rdp_clipboard  = true

# authorized_models MUST mirror Gemini Enterprise > Settings > AI developer tools > Antigravity authorized models
# authorized_models = { "gemini-4-argon" = { display = "Gemini 4 Argon", levels = ["high", "medium", "low"] } ... }
